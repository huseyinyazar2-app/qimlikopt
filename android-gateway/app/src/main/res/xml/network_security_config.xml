<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Varsayilan: duz metin (HTTP) trafigi YASAK.
         Prod sunucu (api.qimlik.com) HTTPS kullandigi icin gateway anahtari ve
         OTP kodlari sifreli gider; aradaki biri okuyamaz. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Yerel agda test icin HTTP'ye izin verilen adresler.
         Kendi bilgisayarinin yerel IP'siyle test edeceksen buraya ekle, ornek:
         <domain includeSubdomains="false">192.168.1.10</domain> -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
