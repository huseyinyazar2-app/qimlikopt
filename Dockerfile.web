# Alti panelin statik yapisi + nginx. Coolify depoyu klonlar, dist burada uretilir.
FROM node:22-alpine AS build
WORKDIR /src

# Manifestleri once kopyala; kaynak degisince npm ci tekrar calismasin.
COPY frontend-website/package.json  frontend-website/package-lock.json  frontend-website/
COPY frontend-admin/package.json    frontend-admin/package-lock.json    frontend-admin/
COPY frontend-client/package.json   frontend-client/package-lock.json   frontend-client/
COPY frontend-dijital/package.json  frontend-dijital/package-lock.json  frontend-dijital/
COPY frontend-mesai/package.json    frontend-mesai/package-lock.json    frontend-mesai/
COPY frontend-teslimat/package.json frontend-teslimat/package-lock.json frontend-teslimat/

RUN set -eux; for d in website admin client dijital mesai teslimat; do \
      cd "/src/frontend-$d" && npm ci --no-audit --no-fund; \
    done

COPY frontend-website/  frontend-website/
COPY frontend-admin/    frontend-admin/
COPY frontend-client/   frontend-client/
COPY frontend-dijital/  frontend-dijital/
COPY frontend-mesai/    frontend-mesai/
COPY frontend-teslimat/ frontend-teslimat/

# API adresi calisma aninda degil, YAPI aninda gomulur. Bos birakilirsa
# frontend/src/config.js *.qimlik.com icin https://api.qimlik.com'a duser.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN set -eux; for d in website admin client dijital mesai teslimat; do \
      cd "/src/frontend-$d" && npm run build; \
    done

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/frontend-website/dist  /usr/share/nginx/html/website
COPY --from=build /src/frontend-admin/dist    /usr/share/nginx/html/admin
COPY --from=build /src/frontend-client/dist   /usr/share/nginx/html/client
COPY --from=build /src/frontend-dijital/dist  /usr/share/nginx/html/dijital
COPY --from=build /src/frontend-mesai/dist    /usr/share/nginx/html/mesai
COPY --from=build /src/frontend-teslimat/dist /usr/share/nginx/html/teslimat
EXPOSE 80
