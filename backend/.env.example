# Server Settings
PORT=3303

# Database (libsql / Turso). Yerel SQLite için: file:local.db
# Uzak Turso için: libsql://... ve ayrıca TURSO_AUTH_TOKEN gerekir.
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=

# Gateway Security (Android uygulamasıyla AYNI olmalı)
GATEWAY_API_KEY=change_me

# JWT: token imzalama sırrı. Güçlü ve gizli olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL=30d
